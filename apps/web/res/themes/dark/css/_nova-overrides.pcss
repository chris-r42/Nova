/* Nova — McLaren orange accent */
/* Must be imported last in dark.pcss to override compound tokens */

:root {
    /* Orange scale replacing Element green */
    --cpd-color-green-100: #1a0900;
    --cpd-color-green-200: #1f0f00;
    --cpd-color-green-300: #251400;
    --cpd-color-green-400: #2e1a00;
    --cpd-color-green-500: #3d2200;
    --cpd-color-green-600: #4a2800;
    --cpd-color-green-700: #5a3500;
    --cpd-color-green-800: #7a4800;
    --cpd-color-green-900: #c05a00;
    --cpd-color-green-1000: #d96800;
    --cpd-color-green-1100: #ff8000;
    --cpd-color-green-1200: #ffaa44;
    --cpd-color-green-1300: #ffd199;
    --cpd-color-green-1400: #ffe8cc;

    --cpd-color-alpha-green-100: hsl(26, 100%, 6%, 1);
    --cpd-color-alpha-green-200: hsl(27, 100%, 7%, 1);
    --cpd-color-alpha-green-300: hsl(28, 100%, 8%, 1);
    --cpd-color-alpha-green-400: hsl(29, 100%, 10%, 1);
    --cpd-color-alpha-green-500: hsl(30, 100%, 13%, 1);
    --cpd-color-alpha-green-600: hsl(30, 100%, 16%, 1);
    --cpd-color-alpha-green-700: hsl(30, 100%, 20%, 1);
    --cpd-color-alpha-green-800: hsl(30, 100%, 28%, 1);
    --cpd-color-alpha-green-900: hsla(30, 100%, 50%, 0.55);
    --cpd-color-alpha-green-1000: hsla(30, 100%, 50%, 0.65);
    --cpd-color-alpha-green-1100: hsla(30, 100%, 50%, 0.75);
    --cpd-color-alpha-green-1200: hsla(30, 100%, 64%, 0.84);
    --cpd-color-alpha-green-1300: hsla(30, 100%, 80%, 0.91);
    --cpd-color-alpha-green-1400: hsla(30, 100%, 90%, 0.96);
}
