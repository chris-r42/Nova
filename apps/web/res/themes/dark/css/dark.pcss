@import "../../../../res/css/_font-sizes.pcss";
@import "../../light/css/_fonts.pcss";
@import "../../light/css/_light.pcss";
@import "_dark.pcss";
@import "../../light/css/_mods.pcss";
@import "../../../../res/css/_components.pcss";
@import "../../../../res/css/_compound.pcss";
@import url("highlight.js/styles/atom-one-dark.min.css");
@import url("github-markdown-css/github-markdown-dark.css");
/* Nova McLaren orange — imported last to override compound tokens */
/* Must use .cpd-theme-dark.cpd-theme-dark to beat compound's specificity */
:root, .cpd-theme-dark.cpd-theme-dark {
    --cpd-color-green-100: #1a0900;
    --cpd-color-green-200: #2a1000;
    --cpd-color-green-300: #3d1800;
    --cpd-color-green-400: #522200;
    --cpd-color-green-500: #6b2e00;
    --cpd-color-green-600: #884000;
    --cpd-color-green-700: #a85200;
    --cpd-color-green-800: #cc6600;
    --cpd-color-green-900: #e87500;
    --cpd-color-green-1000: #f57c00;
    --cpd-color-green-1100: #ff8000;
    --cpd-color-green-1200: #ffaa44;
    --cpd-color-green-1300: #ffd199;
    --cpd-color-green-1400: #ffe8cc;

    --cpd-color-alpha-green-100: hsl(26, 100%, 5%, 1);
    --cpd-color-alpha-green-200: hsl(27, 100%, 8%, 1);
    --cpd-color-alpha-green-300: hsl(28, 100%, 12%, 1);
    --cpd-color-alpha-green-400: hsl(29, 100%, 16%, 1);
    --cpd-color-alpha-green-500: hsl(30, 100%, 21%, 1);
    --cpd-color-alpha-green-600: hsl(30, 100%, 27%, 1);
    --cpd-color-alpha-green-700: hsl(30, 100%, 33%, 1);
    --cpd-color-alpha-green-800: hsl(30, 100%, 40%, 1);
    --cpd-color-alpha-green-900: hsla(30, 100%, 50%, 0.70);
    --cpd-color-alpha-green-1000: hsla(30, 100%, 50%, 0.80);
    --cpd-color-alpha-green-1100: hsla(30, 100%, 50%, 0.88);
    --cpd-color-alpha-green-1200: hsla(30, 100%, 64%, 0.88);
    --cpd-color-alpha-green-1300: hsla(30, 100%, 80%, 0.93);
    --cpd-color-alpha-green-1400: hsla(30, 100%, 90%, 0.97);
}
