/*
 * Nova theme panel — floating customization panel
 */

.nova_ThemeButton_menuWrapper {
    /* Position the floating panel correctly above sidebar */
}

.nova_ThemeButton {
    display: flex;
    align-items: center;
    gap: 8px;
    width: calc(100% - 16px);
    margin: 0 8px 4px;
    padding: 8px;
    border-radius: 8px;
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--cpd-color-text-secondary);

    svg {
        width: 20px;
        height: 20px;
        flex-shrink: 0;
    }

    &:hover {
        background: var(--cpd-color-bg-action-secondary-hovered);
        color: var(--cpd-color-text-primary);
    }

    &.expanded {
        width: calc(100% - 16px);
    }
}

.nova_ThemeButton_label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* Floating panel */

.nova_ThemePanel {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 280px;
    padding: 16px;
    background: var(--cpd-color-bg-subtle-secondary);
    border-radius: 12px;
    border: 1px solid var(--cpd-color-border-interactive);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
    color: var(--cpd-color-text-primary);
}

.nova_ThemePanel_header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--cpd-color-border-interactive);
}

.nova_ThemePanel_saving {
    font-size: 11px;
    color: var(--cpd-color-text-secondary);
    opacity: 0.7;
}

.nova_ThemePanel_section {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 8px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);

    &:last-of-type {
        border-bottom: none;
    }
}

.nova_ThemePanel_sectionLabel {
    color: var(--cpd-color-text-secondary);
    text-transform: uppercase;
    font-size: 10px;
    letter-spacing: 0.08em;
    margin: 0 0 2px;
}

.nova_ThemePanel_row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    min-height: 28px;
}

.nova_ThemePanel_label {
    font-size: 13px;
    color: var(--cpd-color-text-primary);
    flex-shrink: 0;
    min-width: 110px;
}

.nova_ThemePanel_slider {
    flex: 1;
    accent-color: var(--cpd-color-green-1100);
    height: 4px;
    cursor: pointer;
}

.nova_ThemePanel_select {
    flex: 1;
    background: var(--cpd-color-bg-canvas-default);
    border: 1px solid var(--cpd-color-border-interactive);
    border-radius: 6px;
    color: var(--cpd-color-text-primary);
    font-size: 13px;
    padding: 4px 6px;
    cursor: pointer;
    outline: none;

    &:focus {
        border-color: var(--cpd-color-green-1100);
    }
}

.nova_ThemePanel_colorRow {
    display: flex;
    align-items: center;
    gap: 6px;
    flex: 1;
}

.nova_ThemePanel_colorPicker {
    width: 32px;
    height: 28px;
    border: none;
    border-radius: 6px;
    padding: 0;
    cursor: pointer;
    background: none;
    flex-shrink: 0;
}

.nova_ThemePanel_colorHex {
    flex: 1;
    background: var(--cpd-color-bg-canvas-default);
    border: 1px solid var(--cpd-color-border-interactive);
    border-radius: 6px;
    color: var(--cpd-color-text-primary);
    font-size: 13px;
    font-family: monospace;
    padding: 4px 6px;
    outline: none;

    &:focus {
        border-color: var(--cpd-color-green-1100);
    }
}

.nova_ThemePanel_reset {
    margin-top: 8px;
    width: 100%;
    padding: 6px;
    border-radius: 6px;
    border: 1px solid var(--cpd-color-border-interactive);
    background: transparent;
    color: var(--cpd-color-text-secondary);
    font-size: 12px;
    cursor: pointer;

    &:hover {
        background: var(--cpd-color-bg-action-secondary-hovered);
        color: var(--cpd-color-text-primary);
    }
}

/* Profile — banner + bio in user info panel */

.nova_UserInfo_banner {
    width: 100%;
    height: 120px;
    overflow: hidden;
    margin-bottom: -40px;
    flex-shrink: 0;
}

.nova_UserInfo_banner_img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.nova_UserInfo_avatar_hasBanner {
    position: relative;
    z-index: 1;
    margin-top: 0;
    padding-top: 0;

    .mx_UserInfo_avatar_transition_child {
        border: 3px solid var(--cpd-color-bg-canvas-default);
        border-radius: 50%;
    }
}

.nova_UserInfo_bio {
    margin-top: 6px;
    color: var(--cpd-color-text-secondary);
    text-align: center;
    padding: 0 12px;
    white-space: pre-wrap;
    word-break: break-word;
}

/* Profile settings — banner + bio in settings panel */

.nova_ProfileSettings_extended {
    margin-top: 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.nova_ProfileSettings_section {
    font-size: 13px;
    font-weight: 600;
    color: var(--cpd-color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 8px 0 4px;
}

.nova_ProfileSettings_banner {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.nova_ProfileSettings_banner_preview {
    position: relative;
    width: 100%;
    height: 100px;
    border-radius: 8px;
    overflow: hidden;

    img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
}

.nova_ProfileSettings_banner_remove {
    position: absolute;
    top: 6px;
    right: 6px;
    background: rgba(0, 0, 0, 0.6);
    color: white;
    border: none;
    border-radius: 4px;
    padding: 3px 8px;
    font-size: 12px;
    cursor: pointer;

    &:hover {
        background: rgba(0, 0, 0, 0.8);
    }
}

.nova_ProfileSettings_banner_upload {
    align-self: flex-start;
    background: var(--cpd-color-bg-action-secondary-rest);
    color: var(--cpd-color-text-primary);
    border: 1px solid var(--cpd-color-border-interactive);
    border-radius: 6px;
    padding: 6px 14px;
    font-size: 13px;
    cursor: pointer;

    &:hover {
        background: var(--cpd-color-bg-action-secondary-hovered);
    }
}

.nova_ProfileSettings_bio {
    width: 100%;
}

.nova_ProfileSettings_error {
    color: var(--cpd-color-text-critical-primary);
    font-size: 12px;
}

/* Game Clips panel — full-height iframe */

.nova_GameClipsPanel {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    overflow: hidden;
}

.nova_GameClipsPanel_iframe {
    border: none;
    width: 100%;
    height: 100%;
    flex: 1;
}
